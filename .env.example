# Copy to .env for local development: cp .env.example .env

DATABRICKS_CONFIG_PROFILE=DEFAULT

# The same two settings the app gets from resources/app.yml
LLM_ENDPOINT=databricks-claude-sonnet-4-5
VECTOR_SEARCH_INDEX=<catalog>.<schema>.chunks_index

# Tracing (optional locally); the app gets the experiment from the bundle
MLFLOW_TRACKING_URI=databricks
MLFLOW_REGISTRY_URI=databricks-uc
# MLFLOW_EXPERIMENT_ID=

CHAT_APP_PORT=3000
CHAT_PROXY_TIMEOUT_SECONDS=300
